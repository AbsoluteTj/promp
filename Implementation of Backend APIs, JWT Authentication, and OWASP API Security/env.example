# ==============================================================================
# CassavaCare AI Backend - Environment Variables Template (.env.example)
# Pertemuan 06 (PTM-06): Backend Implementation & Security Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# APP CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="CassavaCare AI Backend API"
APP_ENV="development"                  # development | staging | production
DEBUG=True
API_V1_STR="/api/v1"
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Pattern: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
DATABASE_URL="postgresql://cassava_user:CassavaSecurePass2026!@localhost:5432/cassavacare_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate secret key using: openssl rand -hex 32
SECRET_KEY="cassavacare-super-secret-jwt-key-change-this-in-production-2026!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30         # Access Token validity: 30 minutes
REFRESH_TOKEN_EXPIRE_DAYS=7            # Refresh Token validity: 7 days

# Password Hashing Cost (Bcrypt Work Factor)
BCRYPT_LOG_ROUNDS=12

# ------------------------------------------------------------------------------
# AI INFERENCE & FILE UPLOAD SANITIZATION (OWASP API4:2023 Protection)
# ------------------------------------------------------------------------------
# Path to TensorFlow Lite / PyTorch ONNX model
MODEL_PATH="app/models/ai/cassava_model_v1.tflite"
LABELS_PATH="app/models/ai/labels.json"

# File Upload Rules & Thresholds
MAX_FILE_SIZE_MB=10                     # Maximum upload size in Megabytes (10MB)
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/jpg,image/webp"
CONFIDENCE_THRESHOLD=0.70              # 70% threshold for AI confidence [BR-01, AC-02]

# ------------------------------------------------------------------------------
# RATE LIMITING & CORS (OWASP API4:2023 & API8:2023)
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60               # Maximum requests per minute per IP
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,https://cassavacare.id"
